{
  "name": "fnos-app-schulte",
  "version": "1.0.3",
  "description": "舒尔特注意力训练游戏（fnOS Native 应用）",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/server",
    "packages/assets"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config packages/ui/vite.config.ts",
    "dev:server": "node scripts/dev.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "build:web": "vite build --config packages/ui/vite.config.ts",
    "build": "npm run build:web && nitro build",
    "test:levels": "jiti scripts/test-levels.ts",
    "test:db": "jiti scripts/test-db-migration.ts",
    "test:storage": "jiti scripts/test-storage.ts",
    "test:format": "jiti scripts/test-format.ts",
    "test": "npm run test:levels && npm run test:format && npm run test:storage && npm run test:db",
    "start": "node scripts/start.mjs",
    "download:fnpack": "node scripts/download-fnpack.mjs",
    "prepare:package": "node scripts/prepare-package.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "pack:app": "npm run build && npm run prepare:package && bash scripts/pack-app.sh && npm run validate:package",
    "pack:fpk": "npm run download:fnpack && npm run pack:app && bash scripts/pack-fpk.sh"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "lucide-vue-next": "^1.0.0",
    "nitro": "3.0.260610-beta",
    "vite": "^8.0.16",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  }
}
